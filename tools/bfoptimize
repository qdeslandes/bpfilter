class AttemptStatus(enum.Enum):
    PROPOSED = "proposed"               # propose_only mode: no implementation run
    BUILD_FAILED = "build_failed"
    TEST_FAILED = "test_failed"
    BENCHMARK_NO_BETTER = "benchmark_no_better"
    SUCCESS = "success"


@dataclasses.dataclass
class Attempt:
    """Single optimization attempt within a run."""

    id: int
    proposal: Proposal
    status: AttemptStatus
    commit_patch: str | None = None
    benchmark_results: list[dict[str, Any]] | None = None

    def to_dict(self) -> dict[str, Any]:
        return {
            "id": self.id,
            "proposal": self.proposal.to_dict(),
            "status": self.status.value,
            "commit_patch": self.commit_patch,
            "benchmark_results": self.benchmark_results,
        }

    @classmethod
    def from_dict(cls, data: dict[str, Any]) -> Attempt:
        return cls(
            id=data["id"],
            proposal=Proposal.from_dict(data["proposal"]),
            status=AttemptStatus(data["status"]),
            commit_patch=data.get("commit_patch"),
            benchmark_results=data.get("benchmark_results"),
        )


class History:
    """Per-run history of optimization attempts.

    Each invocation creates a fresh timestamped run directory. Attempts
    accumulate within the run so the model can avoid repeating the same
    ideas; previous runs are loaded separately via _load_prior_attempts().
    """

    def __init__(self, cache_dir: pathlib.Path, baseline_sha: str) -> None:
        run_id = datetime.datetime.now().strftime("%Y%m%dT%H%M%S")
        self._path = cache_dir / "runs" / run_id / "history.json"
        self._baseline_sha = baseline_sha
        self._attempts: list[Attempt] = []
        self._save()

    def _save(self) -> None:
        self._path.parent.mkdir(parents=True, exist_ok=True)
        self._path.write_text(
            json.dumps(
                {
                    "baseline_sha": self._baseline_sha,
                    "attempts": [a.to_dict() for a in self._attempts],
                },
                indent=2,
            )
        )

    @property
    def run_dir(self) -> pathlib.Path:
        return self._path.parent

    @property
    def baseline_sha(self) -> str:
        return self._baseline_sha

    @property
    def attempts(self) -> list[Attempt]:
        return self._attempts

    def next_id(self) -> int:
        return (self._attempts[-1].id + 1) if self._attempts else 1

    def add_attempt(self, attempt: Attempt) -> None:
        self._attempts.append(attempt)
        self._save()

    @classmethod
    def resume(cls, path: pathlib.Path) -> History:
        """Load an existing run from *path* (its history.json) and continue it."""
        obj = object.__new__(cls)
        data = json.loads(path.read_text())
        obj._path = path
        obj._baseline_sha = data["baseline_sha"]
        obj._attempts = [Attempt.from_dict(a) for a in data.get("attempts", [])]
        return obj


