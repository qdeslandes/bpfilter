.pill-stopping{background:rgba(251,191,36,.15);color:var(--warn)}
.pill-done{background:rgba(74,222,128,.15);color:var(--success)}
@keyframes pulse{0%,100%{opacity:1}50%{opacity:.45}}
.pill-running{animation:pulse 1.6s ease-in-out infinite}
button{padding:6px 14px;border-radius:6px;border:1px solid var(--border);background:var(--card);color:var(--text);font-family:var(--font);font-size:13px;font-weight:500;cursor:pointer;transition:all .15s}
button:hover:not(:disabled){border-color:var(--accent);color:var(--accent)}
button:disabled{opacity:.35;cursor:not-allowed}
button.primary{background:var(--accent);color:#07090f;border-color:var(--accent);font-weight:600}
button.primary:hover:not(:disabled){opacity:.85;color:#07090f}
button.danger{color:var(--error);border-color:rgba(248,113,113,.25)}
button.danger:hover:not(:disabled){background:rgba(248,113,113,.08);border-color:var(--error)}
.icon-btn{padding:5px 9px;font-size:15px}
main{max-width:1680px;margin:0 auto;padding:20px 20px 48px}
.metrics{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin-bottom:14px}
.metric-card{background:var(--card);border:1px solid var(--border);border-radius:10px;padding:16px 20px}
.metric-label{font-size:11px;color:var(--muted);text-transform:uppercase;letter-spacing:.05em;margin-bottom:4px}
.metric-value{font-size:26px;font-weight:700}
.metric-value.ok{color:var(--success)}.metric-value.err{color:var(--error)}.metric-value.acc{color:var(--accent)}
.dashboard{display:grid;grid-template-columns:1fr 420px;gap:12px;margin-bottom:14px}
.panel{background:var(--card);border:1px solid var(--border);border-radius:10px;overflow:hidden}
.panel-hdr{display:flex;align-items:center;justify-content:space-between;padding:10px 16px;border-bottom:1px solid var(--border);font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.05em;color:var(--muted)}
.chart-wrap{padding:12px;height:320px;position:relative}
.log-panel{display:flex;flex-direction:column}
.log-out{flex:1;overflow-y:auto;padding:10px 14px;font-family:var(--mono);font-size:12px;line-height:1.65;max-height:290px;white-space:pre-wrap;word-break:break-all}
.log-line.ok{color:var(--success)}.log-line.err{color:var(--error)}.log-line.dim{color:var(--muted)}
.history-panel{margin-top:14px}
.htable{width:100%;border-collapse:collapse}
.htable th{text-align:left;padding:8px 12px;font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.05em;color:var(--muted);border-bottom:1px solid var(--border)}
.htable td{padding:10px 12px;border-bottom:1px solid rgba(30,34,52,.5);font-size:13px}
.htable tr.arow{cursor:pointer;transition:background .1s}
.htable tr.arow:hover{background:rgba(255,255,255,.018)}
.htable tr.drow td{padding:0}
.detail-inner{padding:12px 16px 16px;background:var(--surface);border-bottom:1px solid var(--border)}
.badge{display:inline-block;padding:2px 8px;border-radius:4px;font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.03em}
.badge-success{background:rgba(74,222,128,.12);color:var(--success)}
.badge-build_failed,.badge-test_failed{background:rgba(248,113,113,.12);color:var(--error)}
.badge-benchmark_no_better{background:rgba(251,146,60,.12);color:var(--orange)}
.badge-proposed{background:rgba(100,116,139,.12);color:var(--muted)}
.bench-table{width:100%;border-collapse:collapse;font-size:12px;font-family:var(--mono);margin-top:8px}
.bench-table th{color:var(--muted);font-weight:600;text-align:right;padding:4px 8px}
.bench-table th:first-child{text-align:left}
.bench-table td{text-align:right;padding:4px 8px;border-top:1px solid var(--border)}
.bench-table td:first-child{text-align:left;color:var(--text)}
.bench-table .pos{color:var(--error)}.bench-table .neg{color:var(--success)}
.diff-viewer{font-family:var(--mono);font-size:12px;white-space:pre;overflow-x:auto;background:var(--bg);border:1px solid var(--border);border-radius:6px;padding:10px;margin-top:10px;max-height:320px;overflow-y:auto;line-height:1.5}
.diff-add{color:var(--success)}.diff-del{color:var(--error)}.diff-hunk{color:var(--accent)}.diff-meta{color:var(--muted)}
.modal-back{position:fixed;inset:0;background:rgba(0,0,0,.65);z-index:200;display:flex;align-items:center;justify-content:center}
.modal-box{background:var(--surface);border:1px solid var(--border);border-radius:12px;width:580px;max-height:88vh;display:flex;flex-direction:column;overflow:hidden}
.modal-hdr{padding:16px 20px;border-bottom:1px solid var(--border);display:flex;align-items:center;justify-content:space-between;font-weight:600;font-size:15px}
.modal-body{padding:20px;overflow-y:auto;flex:1}
.modal-ftr{padding:14px 20px;border-top:1px solid var(--border);display:flex;justify-content:flex-end;gap:8px}
.fsect{margin-bottom:22px}.fsect-title{font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.06em;color:var(--muted);margin-bottom:10px}
.frow{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:10px}.frow.full{grid-template-columns:1fr}
.fg{display:flex;flex-direction:column;gap:4px}
.fg label{font-size:12px;font-weight:500;color:var(--muted)}
.fg input,.fg select,.fg textarea{background:var(--card);border:1px solid var(--border);border-radius:6px;color:var(--text);font-family:var(--font);font-size:13px;padding:7px 10px;transition:border-color .15s;outline:none}
.fg input:focus,.fg select:focus,.fg textarea:focus{border-color:var(--accent)}
.fg textarea{resize:vertical;min-height:60px;font-family:var(--mono);font-size:12px}
.fcheck{display:flex;align-items:center;gap:8px;margin-bottom:8px;cursor:pointer;font-size:13px}
.fcheck input[type=checkbox]{width:15px;height:15px;cursor:pointer;accent-color:var(--accent)}
.hidden{display:none!important}
@media(max-width:900px){.dashboard{grid-template-columns:1fr}.metrics{grid-template-columns:repeat(2,1fr)}}
</style>
</head>
<body>
<header class="topbar">
  <div class="brand">bfoptimize <span>dashboard</span></div>
  <button class="icon-btn" id="cfg-btn" title="Configure">⚙</button>
  <button class="primary" id="start-btn">▶ Start</button>
  <button class="danger"  id="stop-btn" disabled>■ Stop</button>
  <button class="icon-btn danger" id="reset-btn" title="Reset history">⟳</button>
  <span class="pill pill-idle" id="status-pill">Idle</span>
  <button class="icon-btn" id="theme-btn" title="Toggle theme">🌙</button>
</header>

<div class="modal-back hidden" id="cfg-modal">
  <div class="modal-box" role="dialog">
    <div class="modal-hdr"><span>Configure bfoptimize</span><button class="icon-btn" id="cfg-x">✕</button></div>
    <div class="modal-body">
      <div class="fsect">
        <div class="fsect-title">Run</div>
        <div class="frow">
          <div class="fg"><label>Iterations</label><input type="number" id="f-iterations" value="10" min="1"></div>
          <div class="fg"><label>Sources path</label><input type="text" id="f-sources" value="."></div>
        </div>
        <div class="frow">
          <div class="fg"><label>Build dir</label><input type="text" id="f-build-dir" value="build"></div>
          <div class="fg"><label>Cache dir</label><input type="text" id="f-cache-dir" value=".cache/bfoptimize"></div>
        </div>
        <div class="frow full">
          <div class="fg"><label>Benchmark cache dir</label><input type="text" id="f-bm-cache" value=".cache/bfbencher"></div>
        </div>
      </div>
      <div class="fsect">
        <div class="fsect-title">Model</div>
        <div class="frow">
          <div class="fg"><label>Model</label>
            <select id="f-model"><option value="claude-opus-4-7">claude-opus-4-7</option></select>
          </div>
          <div class="fg"><label>Effort</label>
            <select id="f-effort"><option value="high">high</option><option value="medium">medium</option><option value="low">low</option></select>
          </div>
        </div>
        <div class="frow full">
          <div class="fg"><label>Hint (optional)</label><textarea id="f-hint" placeholder="Optional direction to explore…"></textarea></div>
        </div>
      </div>
      <div class="fsect">
        <div class="fsect-title">Execution</div>
        <label class="fcheck"><input type="checkbox" id="f-propose-only"> Propose-only (no implementation)</label>
        <label class="fcheck"><input type="checkbox" id="f-no-benchmark"> Skip benchmarks</label>
      </div>
      <div class="fsect">
        <div class="fsect-title">Benchmark tuning</div>
        <div class="frow full">
          <div class="fg"><label>Host</label><input type="text" id="f-bm-host" placeholder="hostname"></div>
        </div>
        <div class="frow">
          <div class="fg"><label>NUMA bind node</label><input type="number" id="f-bind-node" placeholder="optional"></div>
          <div class="fg"><label>Pin CPU</label><input type="number" id="f-cpu-pin" placeholder="optional"></div>
        </div>
        <div class="frow full">
          <div class="fg"><label>Systemd slice</label><input type="text" id="f-slice" placeholder="optional"></div>
        </div>
        <label class="fcheck"><input type="checkbox" id="f-no-preempt"> Real-time scheduling (chrt)</label>
      </div>
      <div class="fsect">
        <div class="fsect-title">Advanced</div>
        <label class="fcheck"><input type="checkbox" id="f-resume"> Resume previous run</label>
        <div class="frow full hidden" id="f-resume-row">
          <div class="fg"><label>Run ID (blank = latest)</label><input type="text" id="f-resume-id" placeholder="20240101T120000"></div>
        </div>
      </div>
    </div>
    <div class="modal-ftr">
      <button id="cfg-cancel">Cancel</button>
      <button class="primary" id="cfg-save">Save &amp; close</button>
    </div>
  </div>
</div>

<main>
  <div class="metrics">
    <div class="metric-card"><div class="metric-label">Total</div><div class="metric-value" id="m-total">—</div></div>
    <div class="metric-card"><div class="metric-label">Accepted</div><div class="metric-value ok" id="m-accepted">—</div></div>
    <div class="metric-card"><div class="metric-label">Rejected</div><div class="metric-value err" id="m-rejected">—</div></div>
    <div class="metric-card"><div class="metric-label">Best cumulative Δtime</div><div class="metric-value acc" id="m-best">—</div></div>
  </div>

  <div class="dashboard">
    <div class="panel">
      <div class="panel-hdr"><span>Performance</span></div>
      <div class="chart-wrap"><canvas id="main-chart"></canvas></div>
    </div>
    <div class="panel log-panel">
      <div class="panel-hdr"><span>Output</span><button class="icon-btn" id="clear-log" title="Clear">✕</button></div>
      <div class="log-out" id="log-out"></div>
    </div>
  </div>

  <div class="panel history-panel">
    <div class="panel-hdr"><span>Attempts</span></div>
    <table class="htable">
      <thead><tr>
        <th>#</th><th>Status</th><th>Target function</th>
        <th style="text-align:right">Est. Δinsn</th>
        <th style="text-align:right">Avg Δtime%</th>
        <th style="text-align:right">Cumulative Δtime%</th>
      </tr></thead>
      <tbody id="attempt-tbody"></tbody>
    </table>
  </div>
</main>

<script>
'use strict';
let chart=null,es=null,polling=null,graphData=[],autoScroll=true;
const $=id=>document.getElementById(id);
const fmtPct=v=>v==null?'—':((v>0?'+':'')+v.toFixed(2)+'%');
const fmtNs=ns=>ns==null?'—':((ns/1000).toFixed(1)+' µs');
const esc=s=>s.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');

document.addEventListener('DOMContentLoaded',()=>{
  initChart();
  loadCfg();
  connectSSE();
  fetchHistory();
  $('start-btn').addEventListener('click',startRun);
  $('stop-btn').addEventListener('click',stopRun);
  $('cfg-btn').addEventListener('click',()=>$('cfg-modal').classList.remove('hidden'));
  ['cfg-x','cfg-cancel'].forEach(id=>$('cfg-btn')&&$('cfg-'+id.slice(4))?.addEventListener('click',()=>$('cfg-modal').classList.add('hidden')));
  $('cfg-x').addEventListener('click',()=>$('cfg-modal').classList.add('hidden'));
  $('cfg-cancel').addEventListener('click',()=>$('cfg-modal').classList.add('hidden'));
  $('cfg-save').addEventListener('click',()=>{saveCfg();$('cfg-modal').classList.add('hidden');});
  $('theme-btn').addEventListener('click',toggleTheme);
  $('clear-log').addEventListener('click',()=>$('log-out').innerHTML='');
  $('reset-btn').addEventListener('click',resetHistory);
  $('f-resume').addEventListener('change',e=>$('f-resume-row').classList.toggle('hidden',!e.target.checked));
  $('cfg-modal').addEventListener('click',e=>{if(e.target===$('cfg-modal'))$('cfg-modal').classList.add('hidden');});
  document.addEventListener('keydown',e=>{if(e.key==='Escape')$('cfg-modal').classList.add('hidden');});
  const lo=$('log-out');
  lo.addEventListener('scroll',()=>{autoScroll=lo.scrollTop+lo.clientHeight>=lo.scrollHeight-24;});
  if(localStorage.getItem('bfoptimize_theme')==='light')document.documentElement.classList.add('light');
});

function initChart(){
  chart=new Chart($('main-chart').getContext('2d'),{
    type:'scatter',
    data:{datasets:[
      {type:'scatter',label:'Accepted',data:[],backgroundColor:'#4ade80',pointRadius:7,pointHoverRadius:9,order:1},
      {type:'scatter',label:'Bench no-better',data:[],backgroundColor:'#fb923c',pointRadius:6,pointHoverRadius:8,order:1},
      {type:'scatter',label:'Failed',data:[],backgroundColor:'#f87171',pointRadius:6,pointStyle:'crossRot',pointHoverRadius:8,order:1},
      {type:'scatter',label:'Proposed',data:[],backgroundColor:'#64748b',pointRadius:4,pointHoverRadius:6,order:1},
      {type:'line',label:'Cumulative',data:[],borderColor:'#818cf8',backgroundColor:'rgba(129,140,248,0.07)',stepped:'after',pointRadius:0,fill:true,borderWidth:2,order:0},
      {type:'line',label:'',data:[],borderColor:'rgba(148,163,184,0.18)',borderDash:[4,4],pointRadius:0,fill:false,borderWidth:1,order:2},
    ]},
    options:{
      responsive:true,maintainAspectRatio:false,animation:false,
      scales:{
        x:{type:'linear',min:0,title:{display:true,text:'Attempt',color:'#64748b'},ticks:{color:'#64748b',stepSize:1,precision:0},grid:{color:'rgba(255,255,255,0.04)'}},
        y:{title:{display:true,text:'Δ time %',color:'#64748b'},ticks:{color:'#64748b',callback:v=>v+'%'},grid:{color:'rgba(255,255,255,0.04)'}},
      },
      plugins:{
        legend:{position:'bottom',labels:{color:'#94a3b8',boxWidth:12,filter:i=>i.text!==''}},
        tooltip:{callbacks:{
          title(items){const g=graphData.find(d=>d.id===items[0].raw.x);return g?'#'+g.id+(g.target_function?' — '+g.target_function:''):'';},
          label(item){
            const g=graphData.find(d=>d.id===item.raw.x);if(!g)return item.dataset.label;
            const lines=[item.dataset.label];
            if(g.per_avg!=null)lines.push('  per-attempt:  '+fmtPct(g.per_avg));
            if(g.cumulative!=null)lines.push('  cumulative:   '+fmtPct(g.cumulative));
            if(g.estimated_insn_delta)lines.push('  est. Δinsn:   '+(g.estimated_insn_delta>0?'+':'')+g.estimated_insn_delta);
            return lines;
          }
        }}
      }
    }
  });
}

function updateChart(){
  if(!chart||!graphData.length)return;
  const ds=chart.data.datasets;
  [0,1,2,3,4].forEach(i=>ds[i].data=[]);
  let maxId=0;
  graphData.forEach(g=>{
    maxId=Math.max(maxId,g.id);
    const y=g.per_avg!=null?g.per_avg:0;
    if(g.status==='success')             ds[0].data.push({x:g.id,y});
    else if(g.status==='benchmark_no_better') ds[1].data.push({x:g.id,y});
    else if(g.status==='build_failed'||g.status==='test_failed') ds[2].data.push({x:g.id,y:0});
    else if(g.status==='proposed')       ds[3].data.push({x:g.id,y:0});
    ds[4].data.push({x:g.id,y:g.cumulative??0});
  });
  ds[5].data=[{x:0,y:0},{x:maxId+1,y:0}];
  chart.update();
}

function connectSSE(){
  if(es){es.close();es=null;}
  es=new EventSource('/stream');
  es.onmessage=e=>{
    try{
      const msg=JSON.parse(e.data);
      if(msg.type==='log')appendLog(msg.line);
      else if(msg.type==='done'){fetchHistory();setUiState('done');}
    }catch{}
  };
  es.onerror=()=>{setTimeout(connectSSE,3000);};
}

async function fetchHistory(){
  try{
    const r=await fetch('/history');if(!r.ok)return;
    const d=await r.json();
    graphData=d.graph||[];
    renderMetrics(d.attempts||[]);
    updateChart();
    renderTable(d.attempts||[]);
  }catch{}
}

async function startRun(){
  const cfg=readCfg();
  try{
    const r=await fetch('/run',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(cfg)});
    if(!r.ok){const e=await r.json();alert('Error: '+(e.detail||r.status));return;}
    setUiState('running');
    if(polling)clearInterval(polling);
    polling=setInterval(fetchHistory,10000);
  }catch(e){alert('Failed to start: '+e);}
}

async function stopRun(){
  try{await fetch('/run',{method:'DELETE'});setUiState('stopping');}
  catch(e){alert('Failed to stop: '+e);}
}

async function resetHistory(){
  if(!confirm('Reset history? This will delete the current run data.'))return;
  try{
    const r=await fetch('/history',{method:'DELETE'});
    if(!r.ok){const e=await r.json();alert('Error: '+(e.detail||r.status));return;}
    graphData=[];updateChart();renderMetrics([]);renderTable([]);
    $('log-out').innerHTML='';setUiState('idle');
  }catch(e){alert('Failed to reset: '+e);}
}

function setUiState(s){
  const pill=$('status-pill');
  pill.className='pill pill-'+s;
  pill.textContent={idle:'Idle',running:'Running',stopping:'Stopping',done:'Done'}[s]||s;
  $('start-btn').disabled=s==='running'||s==='stopping';
  $('stop-btn').disabled=s!=='running';
  $('reset-btn').disabled=s==='running'||s==='stopping';
  if(s==='done'||s==='idle'){if(polling){clearInterval(polling);polling=null;}}
}

function appendLog(line){
  const out=$('log-out');
  const d=document.createElement('div');
  d.className='log-line'+(/improvement|success/i.test(line)?' ok':/failed|error/i.test(line)?' err':/\[dim\]|build\+test/i.test(line)?' dim':'');
  d.textContent=line.replace(/\[\/?\w+\]/g,'');
  out.appendChild(d);
  if(autoScroll)out.scrollTop=out.scrollHeight;
}

function renderMetrics(attempts){
  const total=attempts.length;
  const ok=attempts.filter(a=>a.status==='success').length;
  const best=graphData.filter(g=>g.status==='success'&&g.cumulative!=null);
  $('m-total').textContent=total||'—';
  $('m-accepted').textContent=ok||'—';
  $('m-rejected').textContent=(total-ok)||'—';
  $('m-best').textContent=best.length?fmtPct(Math.min(...best.map(g=>g.cumulative))):'—';
}

function renderTable(attempts){
  const tb=$('attempt-tbody');tb.innerHTML='';
  attempts.forEach(a=>{
    const gd=graphData.find(g=>g.id===a.id);
    const tr=document.createElement('tr');tr.className='arow';
    const ins=a.proposal.estimated_insn_delta;
    tr.innerHTML=
      '<td>#'+a.id+'</td>'+
      '<td><span class="badge badge-'+a.status+'">'+a.status.replace(/_/g,' ')+'</span></td>'+
      '<td style="font-family:var(--mono);font-size:12px;color:var(--muted)">'+esc(a.proposal.target_function||'—')+'</td>'+
      '<td style="font-family:var(--mono);text-align:right">'+(ins?(ins>0?'+':'')+ins:'—')+'</td>'+
      '<td style="text-align:right">'+(gd&&gd.per_avg!=null?fmtPct(gd.per_avg):'—')+'</td>'+
      '<td style="text-align:right">'+(gd&&gd.cumulative!=null?fmtPct(gd.cumulative):'—')+'</td>';
    const dtr=document.createElement('tr');dtr.className='drow hidden';
    dtr.innerHTML='<td colspan="6"><div class="detail-inner" id="di-'+a.id+'"></div></td>';
    tr.addEventListener('click',()=>{
      const open=!dtr.classList.contains('hidden');
      document.querySelectorAll('.drow').forEach(r=>r.classList.add('hidden'));
      if(!open){dtr.classList.remove('hidden');renderDetail(a,$('di-'+a.id));}
    });
    tb.appendChild(tr);tb.appendChild(dtr);
  });
}

async function renderDetail(a,el){
  el.innerHTML='<div style="color:var(--muted);font-size:12px">Loading…</div>';
  const [br,dr]=await Promise.all([fetch('/bench/'+a.id),fetch('/diff/'+a.id)]);
  let h='<div style="margin-bottom:14px"><div style="font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.05em;color:var(--muted);margin-bottom:6px">Reasoning</div>';
  h+='<div style="font-size:12px;line-height:1.6;white-space:pre-wrap">'+esc(a.proposal.reasoning||'—')+'</div></div>';
  if(br.ok){
    const rows=await br.json();
    if(rows&&rows.length){
      h+='<div style="font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.05em;color:var(--muted);margin-bottom:4px">Benchmarks</div>';
      h+='<table class="bench-table"><thead><tr><th>Name</th><th>Base</th><th>Ref</th><th>Δtime%</th><th>Base insn</th><th>Ref insn</th><th>Δinsn</th></tr></thead><tbody>';
      rows.forEach(r=>{
        const tc=r.delta_time_pct<0?'neg':r.delta_time_pct>0?'pos':'';
        const ic=r.delta_insn!=null&&r.delta_insn<0?'neg':r.delta_insn>0?'pos':'';
        h+='<tr><td>'+esc(r.name)+'</td><td>'+fmtNs(r.base_time_ns)+'</td><td>'+fmtNs(r.ref_time_ns)+'</td>'+
           '<td class="'+tc+'">'+fmtPct(r.delta_time_pct)+'</td>'+
           '<td>'+(r.base_insn!=null?r.base_insn:'—')+'</td>'+
           '<td>'+(r.ref_insn!=null?r.ref_insn:'—')+'</td>'+
           '<td class="'+ic+'">'+(r.delta_insn!=null?(r.delta_insn>0?'+':'')+r.delta_insn:'—')+'</td></tr>';
      });
      h+='</tbody></table>';
    }
  }
  if(dr.ok){
    const {patch}=await dr.json();
    if(patch){
      h+='<div style="font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.05em;color:var(--muted);margin:14px 0 4px">Diff</div>';
      h+='<div class="diff-viewer">';
      patch.split('\n').forEach(line=>{
        if(line.startsWith('+')&&!line.startsWith('+++'))
          h+='<span class="diff-add">'+esc(line)+'</span>\n';
        else if(line.startsWith('-')&&!line.startsWith('---'))
          h+='<span class="diff-del">'+esc(line)+'</span>\n';
        else if(line.startsWith('@@'))
          h+='<span class="diff-hunk">'+esc(line)+'</span>\n';
        else if(/^(diff |index |---|[+]{3})/.test(line))
          h+='<span class="diff-meta">'+esc(line)+'</span>\n';
        else
          h+=esc(line)+'\n';
      });
      h+='</div>';
    }
  }
  el.innerHTML=h;
}

