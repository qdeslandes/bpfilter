def _handle_tool(
    name: str,
    tool_input: dict[str, Any],
    sources: pathlib.Path,
    allow_writes: bool = False,
) -> str:
    root = sources.resolve()

    if name == "list_dir":
        target = (root / tool_input.get("path", ".")).resolve()
        if not str(target).startswith(str(root)):
            return "error: path outside source tree"
        try:
            entries = sorted(target.iterdir(), key=lambda p: (p.is_file(), p.name))
            return "\n".join(e.name + ("/" if e.is_dir() else "") for e in entries)
        except FileNotFoundError:
            return f"error: {tool_input['path']}: no such directory"

    if name == "read_file":
        target = (root / tool_input["path"]).resolve()
        if not str(target).startswith(str(root)):
            return "error: path outside source tree"
        try:
            return target.read_text(encoding="utf-8")
        except FileNotFoundError:
            return f"error: {tool_input['path']}: no such file"
        except UnicodeDecodeError:
            return f"error: {tool_input['path']}: not valid UTF-8"

    if name == "grep":
        target = (root / tool_input.get("path", ".")).resolve()
        if not str(target).startswith(str(root)):
            return "error: path outside source tree"
        pattern = tool_input.get("pattern", "")
        ctx = int(tool_input.get("context_lines", 3))
        try:
            result = subprocess.run(
                [
                    "grep", "-r", "-n", "-E", "--color=never",
                    f"-C{ctx}", pattern, str(target),
                ],
                capture_output=True,
                text=True,
            )
            output = result.stdout or ""
            if not output.strip():
                return "no matches"
            lines = output.splitlines()
            if len(lines) > 300:
                lines = lines[:300]
                lines.append("...(truncated)...")
            return "\n".join(lines)
        except FileNotFoundError:
            return "error: grep not available"
        except Exception as exc:
            return f"error: {exc}"

    if name == "write_file":
        if not allow_writes:
            return "error: writes not permitted in this phase"
        target = (root / tool_input["path"]).resolve()
        cgen_root = (root / CGEN_DIR).resolve()
        if not str(target).startswith(str(cgen_root)):
            return f"error: writes only allowed under {CGEN_DIR}/"
        try:
            target.write_text(tool_input["content"], encoding="utf-8")
            return "ok"
        except Exception as exc:
            return f"error: {exc}"

    return f"error: unknown tool {name!r}"


def _truncate_output(lines: list[str]) -> str:
    if len(lines) > MAX_BUILD_OUTPUT_LINES:
        lines = lines[:10] + ["...(truncated)..."] + lines[-90:]
    return "\n".join(lines)


def _build(config: Config) -> tuple[bool, str]:
    """Run cmake, fixstyle, and compile test binaries. Returns (success, output)."""
    sources = config.sources.resolve()
    build_dir = (
        config.build_dir
        if config.build_dir.is_absolute()
        else sources / config.build_dir
    )
    ncpus = multiprocessing.cpu_count()
    steps = [
        [
            "cmake",
            "-S", str(sources),
            "-B", str(build_dir),
            "-DNO_DOCS=1",
            "-DCMAKE_BUILD_TYPE=release",
        ],
        ["make", "-C", str(build_dir), "fixstyle"],
        ["make", "-C", str(build_dir), f"-j{ncpus}", "test_bin"],
    ]
    lines: list[str] = []
    for cmd in steps:
        lines.append(f"$ {' '.join(cmd)}")
        result = subprocess.run(cmd, capture_output=True, text=True)
        lines.extend(result.stdout.splitlines())
        if result.returncode != 0:
            lines.extend(result.stderr.splitlines())
            return False, _truncate_output(lines)
    return True, _truncate_output(lines)


def _run_tests(config: Config) -> tuple[bool, str]:
    """Run the test suite. Returns (success, output)."""
    sources = config.sources.resolve()
    build_dir = (
        config.build_dir
        if config.build_dir.is_absolute()
        else sources / config.build_dir
    )
    ncpus = multiprocessing.cpu_count()
    cmd = ["make", "-C", str(build_dir), f"-j{ncpus}", "test"]
    lines = [f"$ {' '.join(cmd)}"]
    result = subprocess.run(cmd, capture_output=True, text=True)
    lines.extend(result.stdout.splitlines())
    if result.returncode != 0:
        lines.extend(result.stderr.splitlines())
        return False, _truncate_output(lines)
    return True, _truncate_output(lines)


def _git_commit(message: str, config: Config) -> None:
    subprocess.run(
        ["git", "commit", "-am", message],
        cwd=config.sources,
        check=True,
    )


def _get_commit_patch(config: Config) -> str:
    return subprocess.check_output(
        ["git", "diff", "HEAD~1", "HEAD"],
        cwd=config.sources,
        text=True,
    )


def _revert_cgen(config: Config) -> None:
    subprocess.run(
        ["git", "checkout", "--", CGEN_DIR],
        cwd=config.sources,
        check=False,
    )


def _discard_commit(config: Config) -> None:
    subprocess.run(
        ["git", "reset", "--hard", "HEAD~1"],
        cwd=config.sources,
        check=True,
    )


def _run_benchmarks(
    config: Config,
    base: str,
    ref: str,
) -> list[dict[str, Any]]:
    """Compare base vs ref using bfbencher. Returns serialized CompareRow list."""
    try:
        from tests.benchmarks import bfbencher
    except ImportError:
        try:
            sys.path.insert(0, str(config.sources.resolve() / "tests" / "benchmarks"))
            import bfbencher  # type: ignore[import-not-found]
        except ImportError as e:
            raise RuntimeError(f"bfbencher not found: {e}") from e

    rows = bfbencher.compare(
        base=base,
        ref=ref,
        sources=config.sources,
        host=config.benchmark_host,
        cache_dir=config.benchmark_cache_dir,
        bind_node=config.benchmark_bind_node,
        no_preempt=config.benchmark_no_preempt,
        cpu_pin=config.benchmark_cpu_pin,
        slice=config.benchmark_slice,
        retry=["wip"],
    )
    return [
        {
            "name": r.name,
            "base_time_ns": r.base_time_ns,
            "ref_time_ns": r.ref_time_ns,
            "delta_time_pct": r.delta_time_pct,
            "base_insn": r.base_insn,
            "ref_insn": r.ref_insn,
            "delta_insn": r.delta_insn,
            "delta_insn_pct": r.delta_insn_pct,
        }
        for r in rows
    ]


def _is_better(results: list[dict[str, Any]]) -> bool:
    """Return True if the average time delta is negative with no individual regression."""
    filtered = [
        r for r in results
        if not r["name"].startswith(BENCHMARK_EXCLUDE_PREFIX)
    ]
    if not filtered:
        return False
    deltas = [r["delta_time_pct"] for r in filtered]
    avg = sum(deltas) / len(deltas)
    return avg < 0 and max(deltas) <= BENCHMARK_REGRESSION_CAP_PCT


def _get_recent_commits(sources: pathlib.Path, n: int = 15) -> str:
    """Return a one-line-per-commit summary of the last *n* commits."""
    try:
        return subprocess.check_output(
            ["git", "log", "--oneline", f"-{n}"],
            cwd=sources,
            text=True,
        ).strip()
    except Exception:
        return ""


def _load_prior_attempts(
    cache_dir: pathlib.Path,
    current_run_dir: pathlib.Path,
    max_attempts: int = 15,
) -> list[Attempt]:
    """Load up to *max_attempts* attempts from previous runs (newest first)."""
    runs_dir = cache_dir / "runs"
    if not runs_dir.exists():
        return []

    prior: list[Attempt] = []
    run_dirs = sorted(
        (p for p in runs_dir.iterdir() if p.is_dir() and p != current_run_dir),
        key=lambda p: p.name,
        reverse=True,
    )

    for run_dir in run_dirs:
        history_file = run_dir / "history.json"
        if not history_file.exists():
            continue
        try:
            data = json.loads(history_file.read_text())
            for a in data.get("attempts", []):
                prior.append(Attempt.from_dict(a))
                if len(prior) >= max_attempts:
                    return prior
        except Exception:
            continue

    return prior


def _proposal_system_prompt(
