def _build_app(config: Config) -> "fastapi.FastAPI":
    import fastapi
    from fastapi.responses import HTMLResponse, StreamingResponse

    app = fastapi.FastAPI(title="bfoptimize", docs_url=None, redoc_url=None)

    @app.get("/", response_class=HTMLResponse)
    async def index() -> str:
        return _HTML

    @app.get("/status")
    async def status() -> dict[str, Any]:
        with _state_lock:
            return {
                "status": _state["status"],
                "log_count": len(_state["log_lines"]),
                "run_dir": str(_state["history_path"].parent)
                if _state["history_path"]
                else None,
            }

    @app.post("/run", status_code=202)
    async def start_run(body: dict[str, Any] = fastapi.Body(...)) -> dict[str, Any]:
        with _state_lock:
            if _state["status"] == "running":
                raise fastapi.HTTPException(409, "already running")
            _state["status"] = "running"
            _state["log_lines"].clear()
            for sub in _state["subscribers"]:
                sub.clear()

        body_cache_dir = pathlib.Path(
            body.get("cache_dir", str(config.cache_dir))
        ).expanduser()
        runs_dir = body_cache_dir / "runs"
        known: set[str] = (
            {p.name for p in runs_dir.iterdir() if p.is_dir()}
            if runs_dir.exists()
            else set()
        )

        cmd = _build_serve_cmd(body)
        proc = subprocess.Popen(
            cmd,
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT,
            text=True,
            bufsize=1,
        )
        with _state_lock:
            _state["process"] = proc

        def _finder() -> None:
            hp = _find_new_run(body_cache_dir, known)
            if hp:
                with _state_lock:
                    _state["history_path"] = hp

        t = threading.Thread(target=_reader_thread_fn, args=(proc,), daemon=True)
        threading.Thread(target=_finder, daemon=True).start()
        with _state_lock:
            _state["reader_thread"] = t
        t.start()
        return {"status": "started"}

    @app.delete("/run")
    async def stop_run() -> dict[str, Any]:
        with _state_lock:
            proc = _state["process"]
            if proc is None:
                raise fastapi.HTTPException(404, "no running process")
            _state["status"] = "stopping"
        proc.terminate()
        return {"status": "stopping"}

    @app.get("/stream")
    async def stream() -> StreamingResponse:
        buf: list[dict] = []

        async def generate() -> Any:
            with _state_lock:
                _state["subscribers"].append(buf)
                existing = list(_state["log_lines"])
            try:
                for line in existing:
                    yield f"data: {json.dumps({'type': 'log', 'line': line})}\n\n"
                last_ping = time.monotonic()
                while True:
                    with _state_lock:
                        items = list(buf)
                        buf.clear()
                    for item in items:
                        yield f"data: {json.dumps(item)}\n\n"
                        if item.get("type") == "done":
                            return
                    if not items:
                        now = time.monotonic()
                        if now - last_ping >= 15:
                            yield 'data: {"type":"ping"}\n\n'
                            last_ping = now
                        await asyncio.sleep(0.1)
            except (asyncio.CancelledError, GeneratorExit):
                pass
            finally:
                with _state_lock:
                    try:
                        _state["subscribers"].remove(buf)
                    except ValueError:
                        pass

        return StreamingResponse(
            generate(),
            media_type="text/event-stream",
            headers={"Cache-Control": "no-cache", "X-Accel-Buffering": "no"},
        )

    @app.get("/history")
    async def history() -> dict[str, Any]:
        with _state_lock:
            hp = _state["history_path"]
        if hp is None or not hp.exists():
            return {"baseline_sha": None, "attempts": [], "graph": []}
        data: dict[str, Any] = json.loads(hp.read_text())
        data["graph"] = _compute_graph_data(data.get("attempts", []))
        return data

    @app.get("/bench/{attempt_id}")
    async def bench(attempt_id: int) -> list[dict[str, Any]]:
        with _state_lock:
            hp = _state["history_path"]
        if hp is None or not hp.exists():
            raise fastapi.HTTPException(404)
        data = json.loads(hp.read_text())
        for a in data.get("attempts", []):
            if a["id"] == attempt_id:
                return a.get("benchmark_results") or []
        raise fastapi.HTTPException(404)

    @app.get("/diff/{attempt_id}")
    async def diff(attempt_id: int) -> dict[str, Any]:
        with _state_lock:
            hp = _state["history_path"]
        if hp is None or not hp.exists():
            raise fastapi.HTTPException(404)
        data = json.loads(hp.read_text())
        for a in data.get("attempts", []):
            if a["id"] == attempt_id:
                return {"patch": a.get("commit_patch") or ""}
        raise fastapi.HTTPException(404)

    @app.delete("/history")
    async def reset_history() -> dict[str, Any]:
        with _state_lock:
            if _state["status"] == "running":
                raise fastapi.HTTPException(409, "cannot reset while running")
            hp = _state["history_path"]
            _state["history_path"] = None
            _state["log_lines"].clear()
            _state["status"] = "idle"
        if hp and hp.exists():
            import shutil
            shutil.rmtree(hp.parent, ignore_errors=True)
        return {"status": "reset"}

    return app


def serve(config: Config) -> int:
    try:
        import uvicorn
    except ImportError:
        print(
            "error: install web dependencies with: "
            "pip install fastapi 'uvicorn[standard]'",
            file=sys.stderr,
        )
        return 1
    app = _build_app(config)
    print(f"bfoptimize dashboard → http://{config.serve_host}:{config.serve_port}")
    uvicorn.run(app, host=config.serve_host, port=config.serve_port, log_level="warning")
    return 0


def main() -> int:
    args = _build_parser().parse_args()
    config = Config.from_args(args)

    if config.serve:
        return serve(config)

    if args.resume is not None:
        if args.resume == "latest":
            history_path = _find_latest_run(config.cache_dir)
            if history_path is None:
                print("error: no previous run found under --cache-dir", file=sys.stderr)
                return 1
        else:
            history_path = config.cache_dir / "runs" / args.resume / "history.json"
            if not history_path.exists():
                print(f"error: run '{args.resume}' not found", file=sys.stderr)
                return 1
        history = History.resume(history_path)
        head_sha = _resolve_baseline(config.sources)
        if head_sha != history.baseline_sha:
            print(
                f"warning: HEAD ({head_sha[:12]}) differs from run baseline "
                f"({history.baseline_sha[:12]})",
                file=sys.stderr,
            )
        print(
            f"resuming {history.run_dir.name} "
            f"({len(history.attempts)} prior attempt(s), baseline {history.baseline_sha[:12]})"
        )
    else:
        history = History(config.cache_dir, _resolve_baseline(config.sources))

    if config.dry_run:
        print(f"config:       {config}")
        print(f"baseline_sha: {history.baseline_sha}")
        print(f"run_dir:      {history.run_dir}")
        return 0

    return run(config, history)


if __name__ == "__main__":
    sys.exit(main())
