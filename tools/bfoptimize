def query_proposal(
    client: "anthropic.Anthropic",
    console: "rich.console.Console",
    config: Config,
    history: History,
    recent_commits: str,
    prior_attempts: list[Attempt],
) -> Proposal:
    """Agentic explore-then-propose loop; returns the submitted Proposal."""
    messages: list[dict[str, Any]] = [
        {
            "role": "user",
            "content": (
                "Ultrathink.\n\n"
                "Explore the bpfilter source tree and propose one concrete "
                "optimization to reduce the number of BPF instructions in "
                "generated programs. When ready, call submit_proposal."
            ),
        }
    ]
    for _ in range(MAX_TOOL_ROUNDS):
        with client.messages.stream(
            model=config.model,
            max_tokens=32000,
            thinking={"type": "adaptive"},
            output_config={"effort": config.effort},
            tools=PROPOSAL_TOOLS,
            system=_proposal_system_prompt(
                history, config, recent_commits, prior_attempts
            ),
            messages=messages,
        ) as stream:
            for event in stream:
                if event.type == "content_block_delta":
                    if event.delta.type == "text_delta" and event.delta.text:
                        console.print(event.delta.text, end="")
            console.print("")
            response = stream.get_final_message()

        for block in response.content:
            if block.type == "tool_use" and block.name == "submit_proposal":
                return Proposal(
                    reasoning=block.input["reasoning"],
                    implementation_plan=block.input["implementation_plan"],
                    target_function=block.input.get("target_function", ""),
                    estimated_insn_delta=block.input.get("estimated_insn_delta", 0),
                )

        if response.stop_reason == "end_turn":
            raise RuntimeError("model stopped without calling submit_proposal")

        tool_results = []
        for block in response.content:
            if block.type == "tool_use":
                console.log(f"[dim]  {block.name}({json.dumps(block.input)})[/]")
                result = _handle_tool(block.name, block.input, config.sources)
                tool_results.append(
                    {
                        "type": "tool_result",
                        "tool_use_id": block.id,
                        "content": result,
                    }
                )

        messages.append({"role": "assistant", "content": response.content})
        messages.append({"role": "user", "content": tool_results})

    raise RuntimeError(
        f"model did not call submit_proposal within {MAX_TOOL_ROUNDS} rounds"
    )


def execute_implementation(
    client: "anthropic.Anthropic",
    console: "rich.console.Console",
    config: Config,
    proposal: Proposal,
) -> tuple[AttemptStatus, str | None]:
    """Drive the write→build→fix loop. Returns (status, commit_patch | None).

    The model edits files in cgen/ and calls commit when satisfied. On commit,
    bfoptimize runs build+tests first; failures are fed back so the model can
    fix them. Succeeds only when both pass, at which point the commit is
    executed and the patch returned.
    """
    messages: list[dict[str, Any]] = [
        {
            "role": "user",
            "content": (
                f"Ultrathink.\n\n"
                f"Implement the following optimization in {CGEN_DIR}/.\n\n"
                f"## Reasoning\n\n{proposal.reasoning}\n\n"
                f"## Implementation plan\n\n{proposal.implementation_plan}\n\n"
                f"Use read_file to inspect any file in the tree and write_file to "
                f"apply changes (writes restricted to {CGEN_DIR}/). "
                f"Call commit when your implementation is ready — bfoptimize will "
                f"run build and tests before committing, and return the output if "
                f"they fail so you can fix the issues."
            ),
        }
    ]
    build_attempts = 0

    for _ in range(MAX_TOOL_ROUNDS):
        with client.messages.stream(
            model=config.model,
            max_tokens=32000,
            thinking={"type": "adaptive"},
            output_config={"effort": config.effort},
            tools=IMPLEMENTATION_TOOLS,
            system=_implementation_system_prompt(),
            messages=messages,
        ) as stream:
            for event in stream:
                if event.type == "content_block_delta":
                    if event.delta.type == "text_delta" and event.delta.text:
                        console.print(event.delta.text, end="")
            console.print("")
            response = stream.get_final_message()

        messages.append({"role": "assistant", "content": response.content})

        commit_calls = [
            b for b in response.content if b.type == "tool_use" and b.name == "commit"
        ]
        other_calls = [
            b
            for b in response.content
            if b.type == "tool_use" and b.name != "commit"
        ]

        # Handle file operations; defer commit if mixed with writes.
        if other_calls:
            tool_results = []
            for block in other_calls:
                console.log(f"[dim]  {block.name}({json.dumps(block.input)})[/]")
                result = _handle_tool(
                    block.name, block.input, config.sources, allow_writes=True
                )
                tool_results.append(
                    {"type": "tool_result", "tool_use_id": block.id, "content": result}
                )
            for block in commit_calls:
                tool_results.append(
                    {
                        "type": "tool_result",
                        "tool_use_id": block.id,
                        "content": "error: commit must be the only tool call; finish file edits first",
                    }
                )
            messages.append({"role": "user", "content": tool_results})
            continue

        if commit_calls:
            commit_call = commit_calls[0]
            build_attempts += 1
            console.log(
                f"[dim]build+test (attempt {build_attempts}/{MAX_IMPL_LOOP})[/dim]"
            )

            build_ok, build_output = _build(config)
            if not build_ok:
                console.log("[yellow]build failed[/yellow]")
                if build_attempts >= MAX_IMPL_LOOP:
                    _revert_cgen(config)
                    return AttemptStatus.BUILD_FAILED, None
                messages.append(
                    {
                        "role": "user",
                        "content": [
                            {
                                "type": "tool_result",
                                "tool_use_id": commit_call.id,
                                "content": (
                                    f"Build failed (attempt {build_attempts}/{MAX_IMPL_LOOP}). "
                                    f"Fix the issues and call commit again.\n\n"
                                    f"```\n{build_output}\n```"
                                ),
                            }
                        ],
                    }
                )
                continue

            test_ok, test_output = _run_tests(config)
            if not test_ok:
                console.log("[yellow]tests failed[/yellow]")
                if build_attempts >= MAX_IMPL_LOOP:
                    _revert_cgen(config)
                    return AttemptStatus.TEST_FAILED, None
                messages.append(
                    {
                        "role": "user",
                        "content": [
                            {
                                "type": "tool_result",
                                "tool_use_id": commit_call.id,
                                "content": (
                                    f"Tests failed (attempt {build_attempts}/{MAX_IMPL_LOOP}). "
                                    f"Fix the issues and call commit again.\n\n"
                                    f"```\n{test_output}\n```"
                                ),
                            }
                        ],
                    }
                )
                continue

            no_changes = subprocess.run(
                ["git", "diff", "--quiet", "HEAD", "--", CGEN_DIR],
                cwd=config.sources,
            ).returncode == 0
            if no_changes:
                messages.append(
                    {
                        "role": "user",
                        "content": [
                            {
                                "type": "tool_result",
                                "tool_use_id": commit_call.id,
                                "content": (
                                    "No changes detected in the source tree. "
                                    "Your write_file calls did not produce any net "
                                    f"difference relative to HEAD in {CGEN_DIR}/. "
                                    "Make the actual code changes and call commit again."
                                ),
                            }
                        ],
                    }
                )
                continue

            _git_commit(commit_call.input["message"], config)
            patch = _get_commit_patch(config)
            return AttemptStatus.SUCCESS, patch

        # No tool calls — prompt the model to commit when ready.
        if response.stop_reason == "end_turn":
            messages.append(
                {
                    "role": "user",
                    "content": "Call commit when your implementation is ready.",
                }
            )

    _revert_cgen(config)
    return AttemptStatus.BUILD_FAILED, None


def run(config: Config, history: History) -> int:
    """Optimization loop."""
    try:
        import anthropic
        import rich.console
    except ImportError as e:
        print(
            f"error: {e}\n"
            "install dependencies with: "
            "pip install -r tools/bfoptimize.requirements.txt",
            file=sys.stderr,
        )
        return 1

    console = rich.console.Console(log_path=False)
    client = anthropic.Anthropic()

    recent_commits = _get_recent_commits(config.sources)
    prior_attempts = _load_prior_attempts(config.cache_dir, history.run_dir)

    for i in range(config.iterations):
        attempt_id = history.next_id()
        console.log(f"[bold]Attempt {attempt_id} ({i + 1}/{config.iterations})[/bold]")

        try:
            proposal = query_proposal(
                client, console, config, history, recent_commits, prior_attempts
            )
        except Exception as exc:
            console.log(f"[red]proposal failed: {exc}[/red]")
            return 1

        console.log("[dim]proposal:[/dim]")
        console.log(f"[dim]  reasoning: {proposal.reasoning[:200].strip()}[/dim]")
        console.log(
            f"[dim]  plan: {proposal.implementation_plan[:200].strip()}[/dim]"
        )
        if proposal.target_function:
            console.log(f"[dim]  target: {proposal.target_function}[/dim]")
        if proposal.estimated_insn_delta:
            console.log(f"[dim]  Δinsn: {proposal.estimated_insn_delta:+d}[/dim]")

        if config.propose_only:
            history.add_attempt(
                Attempt(
                    id=attempt_id,
                    proposal=proposal,
                    status=AttemptStatus.PROPOSED,
                )
            )
            console.log("[yellow]--propose-only: skipping implementation[/yellow]")
            continue

        pre_attempt_sha = _get_head_sha(config)

        status, commit_patch = execute_implementation(
            client, console, config, proposal
        )
        console.log(f"implementation status: {status.value}")

        benchmark_results: list[dict[str, Any]] | None = None

        if status == AttemptStatus.SUCCESS:
            if config.no_benchmark:
                console.log("[yellow]--no-benchmark: keeping commit[/yellow]")
            else:
                console.log("[dim]running benchmarks…[/dim]")
                try:
                    benchmark_results = _run_benchmarks(
                        config, pre_attempt_sha, "HEAD"
                    )
                except Exception as exc:
                    console.log(f"[red]benchmark failed: {exc} — keeping commit[/red]")
                else:
                    if _is_better(benchmark_results):
                        console.log("[green]benchmark: improvement — keeping commit[/green]")
                    else:
                        console.log(
                            "[yellow]benchmark: no improvement — discarding commit[/yellow]"
                        )
                        _discard_commit(config)
                        status = AttemptStatus.BENCHMARK_NO_BETTER
                        commit_patch = None

        history.add_attempt(
            Attempt(
                id=attempt_id,
                proposal=proposal,
                status=status,
                commit_patch=commit_patch,
                benchmark_results=benchmark_results,
            )
        )
        console.log(f"attempt result: {status.value}")

    return 0


# ---------------------------------------------------------------------------
# Serve mode — module-level state (only live when --serve is active)
# ---------------------------------------------------------------------------

_state: dict[str, Any] = {
    "status": "idle",       # idle | running | stopping | done
    "log_lines": [],        # accumulated stripped log lines
    "history_path": None,   # pathlib.Path | None — current run's history.json
    "process": None,        # subprocess.Popen | None
    "reader_thread": None,  # threading.Thread | None
    "subscribers": [],      # list[list[dict]] — one mutable list per SSE client
}
_state_lock = threading.Lock()


def _strip_ansi(text: str) -> str:
    return re.sub(r"\x1b\[[0-9;]*[mGKHF]", "", text)


def _broadcast(item: dict) -> None:
    with _state_lock:
        if item.get("type") == "log":
            _state["log_lines"].append(item["line"])
        for sub in _state["subscribers"]:
            sub.append(item)


def _reader_thread_fn(proc: subprocess.Popen) -> None:
    assert proc.stdout is not None
    for raw in proc.stdout:
        line = _strip_ansi(raw.rstrip("\n"))
        if line:
            _broadcast({"type": "log", "line": line})
    proc.wait()
    with _state_lock:
        _state["status"] = "done"
        _state["process"] = None
    _broadcast({"type": "done"})


def _find_new_run(
    cache_dir: pathlib.Path,
    known: set[str],
    timeout: float = 15.0,
) -> pathlib.Path | None:
    runs_dir = cache_dir / "runs"
    deadline = time.monotonic() + timeout
    while time.monotonic() < deadline:
        if runs_dir.exists():
            for p in sorted(runs_dir.iterdir(), key=lambda x: x.name, reverse=True):
                if p.is_dir() and p.name not in known:
                    hp = p / "history.json"
                    if hp.exists():
                        return hp
        time.sleep(0.5)
    return None


def _build_serve_cmd(data: dict) -> list[str]:
    cmd = [sys.executable, str(_SCRIPT_PATH)]
    cmd += ["--iterations", str(int(data.get("iterations", DEFAULT_ITERATIONS)))]
    cmd += ["--sources", data.get("sources", str(DEFAULT_SOURCES)) or str(DEFAULT_SOURCES)]
    cmd += ["--build-dir", data.get("build_dir", str(DEFAULT_BUILD_DIR)) or str(DEFAULT_BUILD_DIR)]
    cmd += ["--cache-dir", data.get("cache_dir", str(DEFAULT_CACHE_DIR)) or str(DEFAULT_CACHE_DIR)]
    cmd += ["--benchmark-cache-dir", data.get("benchmark_cache_dir", str(DEFAULT_BENCHMARK_CACHE_DIR)) or str(DEFAULT_BENCHMARK_CACHE_DIR)]
    cmd += ["--model", data.get("model", DEFAULT_MODEL) or DEFAULT_MODEL]
    cmd += ["--effort", data.get("effort", DEFAULT_EFFORT) or DEFAULT_EFFORT]
    if data.get("hint"):
        cmd += ["--hint", data["hint"]]
    if data.get("propose_only"):
        cmd.append("--propose-only")
    if data.get("no_benchmark"):
        cmd.append("--no-benchmark")
    if data.get("benchmark_host"):
        cmd += ["--benchmark-host", data["benchmark_host"]]
    if data.get("benchmark_bind_node") is not None:
        cmd += ["--benchmark-bind-node", str(int(data["benchmark_bind_node"]))]
    if data.get("benchmark_cpu_pin") is not None:
        cmd += ["--benchmark-cpu-pin", str(int(data["benchmark_cpu_pin"]))]
    if data.get("benchmark_no_preempt"):
        cmd.append("--benchmark-no-preempt")
    if data.get("benchmark_slice"):
        cmd += ["--benchmark-slice", data["benchmark_slice"]]
    if data.get("resume"):
        if data.get("resume_id"):
            cmd += ["--resume", data["resume_id"]]
        else:
            cmd.append("--resume")
    return cmd


def _compute_graph_data(attempts: list[dict]) -> list[dict]:
    factor = 1.0
    result = []
    for a in attempts:
        per_avg = None
        bm = a.get("benchmark_results")
        if bm:
            filtered = [r for r in bm if not r["name"].startswith(BENCHMARK_EXCLUDE_PREFIX)]
            if filtered:
                per_avg = sum(r["delta_time_pct"] for r in filtered) / len(filtered)
        if a["status"] == AttemptStatus.SUCCESS.value and per_avg is not None:
            factor *= 1 + per_avg / 100
        result.append({
            "id": a["id"],
            "status": a["status"],
            "target_function": a["proposal"].get("target_function", ""),
            "estimated_insn_delta": a["proposal"].get("estimated_insn_delta", 0),
            "per_avg": per_avg,
            "cumulative": (factor - 1) * 100,
        })
    return result


