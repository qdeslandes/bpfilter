def _find_latest_run(cache_dir: pathlib.Path) -> pathlib.Path | None:
    """Return the history.json of the most recent run, or None if no runs exist."""
    runs_dir = cache_dir / "runs"
    if not runs_dir.exists():
        return None
    candidates = sorted(
        (p / "history.json" for p in runs_dir.iterdir()
         if p.is_dir() and (p / "history.json").exists()),
        key=lambda p: p.parent.name,
        reverse=True,
    )
    return candidates[0] if candidates else None


