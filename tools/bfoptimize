@dataclasses.dataclass
class Proposal:
    reasoning: str
    implementation_plan: str
    target_function: str = ""
    estimated_insn_delta: int = 0

    def to_dict(self) -> dict[str, Any]:
        return {
            "reasoning": self.reasoning,
            "implementation_plan": self.implementation_plan,
            "target_function": self.target_function,
            "estimated_insn_delta": self.estimated_insn_delta,
        }

    @classmethod
    def from_dict(cls, data: dict[str, Any]) -> Proposal:
        return cls(
            reasoning=data["reasoning"],
            implementation_plan=data["implementation_plan"],
            target_function=data.get("target_function", ""),
            estimated_insn_delta=data.get("estimated_insn_delta", 0),
        )


